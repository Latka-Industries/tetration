### macOS Patch ###
# iCloud generated files
*.icloud

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
dist/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Test data
test-data/

.vscode/

# Local maintainer docs (not for PR / not tracked)
docs/.local/

# cargo-fuzz: keep *.tet / *.pkgfuzz seeds tracked; ignore mutated corpus + build/crash dirs
fuzz/target/
fuzz/artifacts/
fuzz/coverage/
fuzz/corpus/**/*
!fuzz/corpus/**/
!fuzz/corpus/**/*.tet
!fuzz/corpus/**/*.pkgfuzz

# Local UBLX browser config
.ublx.toml

